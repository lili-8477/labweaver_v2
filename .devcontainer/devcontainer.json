{
  "name": "labweaver devcontainer",
  "build": {
    "context": "..",
    "dockerfile": "../image/Dockerfile"
  },
  "remoteUser": "node",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder}/hub/workspaces/devuser/.labweaver,target=/workspace/.labweaver,type=bind",
    "source=${localWorkspaceFolder}/hub/workspaces/devuser/.dsh,target=/home/node/.dsh,type=bind"
  ],
  "runArgs": [
    "--network=host"
  ],
  "containerEnv": {
    "SERVICE_ID": "${localEnv:LABWEAVER_SERVICE_ID}",
    "NATS_SERVERS": "nats://localhost:4223",
    "WORKSPACE_ROOT": "/workspace",
    "DEFAULT_PROJECT": "/workspace",
    "HOME": "/home/node"
  },
  "postCreateCommand": "node --version && node /opt/adapter/node_modules/@deepseek-ai/dsh/lib/bin.js --help | head -1"
}
